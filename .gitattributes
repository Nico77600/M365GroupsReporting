src/*.cs -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
engine/*.csproj -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
lib/**/*.dll -text
