<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Group Inventory engine (.NET 8 class library). Offline, reproducible build:
      - no PackageReference: SQLite comes from the DLLs already committed under ..\lib\sqlite;
      - when the .NET 8 targeting pack is not installed, Build-Engine.ps1 passes
        -p:Net8RuntimeDir=<installed Microsoft.NETCore.App 8.0.x folder> and the engine is
        compiled against that local runtime instead of downloading the pack.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GroupInventory.Engine</AssemblyName>
    <RootNamespace>GroupInventory.Engine</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <SqliteLibDir>$(MSBuildThisFileDirectory)..\lib\sqlite\</SqliteLibDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Net8RuntimeDir)' != ''">
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnableTargetingPackDownload>false</EnableTargetingPackDownload>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Net8RuntimeDir)' != ''">
    <Reference Include="$(Net8RuntimeDir)\System*.dll;$(Net8RuntimeDir)\Microsoft.*.dll;$(Net8RuntimeDir)\mscorlib.dll;$(Net8RuntimeDir)\netstandard.dll;$(Net8RuntimeDir)\WindowsBase.dll"
               Exclude="$(Net8RuntimeDir)\*.Native.dll;$(Net8RuntimeDir)\Microsoft.DiaSymReader.Native*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Data.Sqlite"><HintPath>$(SqliteLibDir)Microsoft.Data.Sqlite.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SQLitePCLRaw.core"><HintPath>$(SqliteLibDir)SQLitePCLRaw.core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2"><HintPath>$(SqliteLibDir)SQLitePCLRaw.batteries_v2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3"><HintPath>$(SqliteLibDir)SQLitePCLRaw.provider.e_sqlite3.dll</HintPath><Private>true</Private></Reference>
    <None Include="$(SqliteLibDir)runtimes\**\*.dll" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\GroupInventory.template.html" Link="GroupInventory.template.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
